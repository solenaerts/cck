---
import Base from "../layouts/Base.astro";

import { getCollection, render } from "astro:content";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const items = await Promise.all(
  news.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<Base title="News">
  <div class="container">
    <h2><span>News</span></h2>
    <p class="code" hidden>The third digit of the code is 3</p>
    <ul>
      {
        items.map(({ item, Content }) => (
          <li>
            <article>
              <h3>{item.data.title}</h3>
              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toDateString()}
              </time>
              <div class="md">
                <Content />
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<script>
  const title = document.querySelector(".container h2");
  const code = document.querySelector<HTMLElement>(".code");
  let clicks = 0;
  title?.addEventListener("click", () => {
    clicks++;
    if (clicks === 3 && code) code.hidden = false;
  });
</script>

<style>
  ul > li:not(:last-child) {
    border-bottom: solid grey 1px;
    padding-bottom: var(--sp-l);
    margin-bottom: var(--sp-xl);
  }

  h3 {
    margin-bottom: var(--sp-2xs);
  }

  time {
    display: block;
    margin-bottom: var(--sp-l);
  }
</style>
